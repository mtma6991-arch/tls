# ─────────────────────────────────────────────────────────────
# IR-TLS Toolkit — فایل پیکربندی نمونه
# این فایل را کپی کنید (مثلاً به config/my-domain.env) و مقادیر را پر کنید.
# هرگز فایل واقعی حاوی کلیدهای API را commit نکنید (در .gitignore قرار دارد).
# ─────────────────────────────────────────────────────────────

# دامنه‌ای که می‌خواهید گواهی برایش صادر شود (بدون www، یا با آن—جداگانه اضافه کنید)
DOMAIN="example.ir"

# می‌توانید چند دامنه/زیردامنه با کاما جدا کنید:
# EXTRA_DOMAINS="www.example.ir,api.example.ir"
EXTRA_DOMAINS=""

# ایمیل برای اعلان‌های انقضا و ثبت حساب نزد CA
EMAIL="you@example.com"

# نام پلاگین DNS در acme.sh — فهرست کامل در docs/DNS-PROVIDERS.md
# نمونه‌های رایج: dns_cf (Cloudflare) | dns_aws (Route53) | dns_gcloud (Google Cloud DNS)
#                dns_dgon (DigitalOcean) | dns_namecheap | manual (حالت دستی/بدون API)
DNS_PROVIDER="dns_cf"

# ترتیب تلاش برای CA؛ اولین مورد که موفق شود استفاده می‌شود.
# مقادیر مجاز: letsencrypt, zerossl, buypass
CA_ORDER="letsencrypt,zerossl,buypass"

# نوع کلید گواهی: ec-256 (پیش‌فرض، سبک‌تر و سریع‌تر) یا 2048 (RSA سنتی)
KEY_TYPE="ec-256"

# ── کلیدهای API ارائه‌دهندهٔ DNS ──
# فقط بخش مربوط به DNS_PROVIDER انتخابی خود را پر کنید؛ بقیه را خالی بگذارید.

# Cloudflare (dns_cf)
CF_Token=""
CF_Account_ID=""

# AWS Route53 (dns_aws)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Google Cloud DNS (dns_gcloud)
# از gcloud CLI با مجوزهای لازم از قبل باید لاگین کرده باشید؛ این پلاگین از آن استفاده می‌کند.

# DigitalOcean (dns_dgon)
DO_API_KEY=""

# Namecheap (dns_namecheap)
NAMECHEAP_USERNAME=""
NAMECHEAP_API_KEY=""
NAMECHEAP_SOURCEIP=""
